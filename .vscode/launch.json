{
  "version": "0.2.0",
  "configurations": [
    {
      // A launch configuration is generally easier for an integrated experience
      "name": "Launch Nodemon and Debug",
      "type": "node",
      "request": "launch",
      // Change 'index.js' to the entry point of your Node.js application
      "program": "${workspaceFolder}/index.js",
      "cwd": "${workspaceFolder}",
      
      // Specify nodemon as the runtime executable
      "runtimeExecutable": "nodemon",
      
      // Pass the --inspect flag to allow the debugger to attach
      "runtimeArgs": ["--inspect=9229"],
      
      // These options ensure a smooth debugging experience with nodemon restarts
      "restart": true, // Automatically re-attach when nodemon restarts the process
      "port": 9229,     // The port the debugger connects to (must match above)
      "console": "integratedTerminal", // View app output in the VS Code terminal
      "internalConsoleOptions": "neverOpen"
    }
    // You can keep your original "Attach to Nodemon" config as a fallback if you like:
    /*
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to Nodemon (Manual Pick)",
      "processId": "${command:PickProcess}",
      "restart": true,
      "protocol": "inspector"
    }
    */
  ]
}